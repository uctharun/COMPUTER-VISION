        "plt.subplot(1,3,2)\n",
        "plt.imshow(bigger)\n",
        "plt.title(\"Bigger (2x)\")\n",
        "plt.axis(\"off\")\n",
        "\n",
        "plt.subplot(1,3,3)\n",
        "plt.imshow(smaller)\n",
        "plt.title(\"Smaller (0.5x)\")\n",
